# Development defaults. Never commit a real JWT secret.
APP_ENVIRONMENT=development
DATABASE_MODE=postgres
DATABASE_URL=postgresql+psycopg://gaming_room:gaming_room@localhost:5433/gaming_room
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
AI_EVENT_COOLDOWN_SECONDS=8
